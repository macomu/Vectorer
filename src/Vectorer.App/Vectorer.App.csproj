<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>Avalonia desktop UI application for Vectorer SVG editor.</Description>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vectorer.Abstractions\Vectorer.Abstractions.csproj" />
    <ProjectReference Include="..\Vectorer.Core\Vectorer.Core.csproj" />
    <ProjectReference Include="..\Vectorer.Svg\Vectorer.Svg.csproj" />
    <ProjectReference Include="..\Vectorer.Rendering\Vectorer.Rendering.csproj" />
    <ProjectReference Include="..\Vectorer.Plugins\Vectorer.Plugins.csproj" />
    <ProjectReference Include="..\..\plugins\Vectorer.SamplePlugin\Vectorer.SamplePlugin.csproj" />
  </ItemGroup>
</Project>

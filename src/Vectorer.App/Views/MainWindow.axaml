<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Vectorer.App.ViewModels"
        xmlns:controls="using:Vectorer.App.Controls"
        xmlns:converters="using:Vectorer.App.Converters"
        xmlns:plugins="using:Vectorer.Abstractions.Plugins"
        xmlns:docs="using:Vectorer.Abstractions.Documents"
        xmlns:styling="using:Vectorer.Abstractions.Styling"
        x:Class="Vectorer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800" MinWidth="1024" MinHeight="720"
        Background="#0D1117">
  <Window.Resources>
    <converters:NullableDecimalToDoubleConverter x:Key="NullableDecimalToDoubleConverter" />
    <DataTemplate x:Key="LocalizedChoiceTemplate" x:DataType="vm:LocalizedChoice">
      <TextBlock Text="{Binding Label}" />
    </DataTemplate>
    <DataTemplate x:Key="ShaderOptionTemplate" x:DataType="vm:ShaderOptionItem">
      <TextBlock Text="{Binding DisplayName}" />
    </DataTemplate>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="NumericUpDown"><Setter Property="MinWidth" Value="115" /><Setter Property="FormatString" Value="0.##" /></Style>
    <Style Selector="ListBox.tools ListBoxItem"><Setter Property="Padding" Value="8" /><Setter Property="Margin" Value="3,2" /><Setter Property="HorizontalContentAlignment" Value="Center" /></Style>
  </Window.Styles>
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveDocumentAsCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+E" Command="{Binding ExportPngCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding DocumentPropertiesCommand}" />
  </Window.KeyBindings>
  <DockPanel IsEnabled="{Binding !IsBusy}">
    <Menu DockPanel.Dock="Top" Background="#161B22">
      <MenuItem Header="{Binding L10n.Menu_File, Mode=OneWay}">
        <MenuItem Header="{Binding L10n.Menu_File_New, Mode=OneWay}" InputGesture="Ctrl+N" Command="{Binding NewDocumentCommand}" />
        <MenuItem Header="{Binding L10n.Menu_File_Open, Mode=OneWay}" InputGesture="Ctrl+O" Command="{Binding OpenDocumentCommand}" />
        <MenuItem Header="{Binding L10n.Menu_File_Recent, Mode=OneWay}" ItemsSource="{Binding RecentFileMenuItems}">
          <MenuItem.ItemContainerTheme>
            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:RecentFileMenuEntry">
              <Setter Property="Header" Value="{Binding Header}" />
              <Setter Property="ToolTip.Tip" Value="{Binding Header}" />
              <Setter Property="Command" Value="{Binding Command}" />
              <Setter Property="CommandParameter" Value="{Binding Parameter}" />
              <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            </ControlTheme>
          </MenuItem.ItemContainerTheme>
        </MenuItem>
        <MenuItem Header="{Binding L10n.Menu_File_Save, Mode=OneWay}" InputGesture="Ctrl+S" Command="{Binding SaveDocumentCommand}" />
        <MenuItem Header="{Binding L10n.Menu_File_SaveAs, Mode=OneWay}" InputGesture="Ctrl+Shift+S" Command="{Binding SaveDocumentAsCommand}" />
        <MenuItem Header="{Binding L10n.Menu_File_ExportPng, Mode=OneWay}" InputGesture="Ctrl+Shift+E" Command="{Binding ExportPngCommand}" />
        <Separator /><MenuItem Header="{Binding L10n.Menu_File_DocumentSettings, Mode=OneWay}" InputGesture="Ctrl+Shift+P" Command="{Binding DocumentPropertiesCommand}" />
        <MenuItem Header="{Binding L10n.Menu_File_Exit, Mode=OneWay}" InputGesture="Alt+F4" Command="{Binding ExitApplicationCommand}" />
      </MenuItem>
      <MenuItem Header="{Binding L10n.Menu_Edit, Mode=OneWay}">
        <MenuItem Header="{Binding L10n.Menu_Edit_Undo, Mode=OneWay}" InputGesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Edit_Redo, Mode=OneWay}" InputGesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
        <Separator />
        <MenuItem Header="{Binding L10n.Menu_Edit_Cut, Mode=OneWay}" InputGesture="Ctrl+X" Command="{Binding CutSelectionCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Edit_Copy, Mode=OneWay}" InputGesture="Ctrl+C" Command="{Binding CopySelectionCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Edit_Paste, Mode=OneWay}" InputGesture="Ctrl+V" Command="{Binding PasteCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Edit_Duplicate, Mode=OneWay}" InputGesture="Ctrl+D" Command="{Binding DuplicateSelectionCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Edit_Delete, Mode=OneWay}" InputGesture="Delete" Command="{Binding DeleteSelectionCommand}" />
        <Separator /><MenuItem Header="{Binding L10n.Menu_Edit_SelectAll, Mode=OneWay}" InputGesture="Ctrl+A" Command="{Binding SelectAllCommand}" />
      </MenuItem>
      <MenuItem Header="{Binding L10n.Menu_View, Mode=OneWay}">
        <MenuItem Header="{Binding L10n.Menu_View_ZoomIn, Mode=OneWay}" InputGesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
        <MenuItem Header="{Binding L10n.Menu_View_ZoomOut, Mode=OneWay}" InputGesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
        <MenuItem Header="{Binding L10n.Menu_View_Zoom100, Mode=OneWay}" InputGesture="Ctrl+1" Command="{Binding ResetZoomCommand}" />
        <MenuItem Header="{Binding L10n.Menu_View_FitCanvas, Mode=OneWay}" InputGesture="Ctrl+0" Command="{Binding FitCanvasCommand}" />
        <MenuItem Header="{Binding L10n.Menu_View_ToggleGrid, Mode=OneWay}" Command="{Binding ToggleGridCommand}" />
        <MenuItem Header="{Binding L10n.Menu_View_ToggleSnap, Mode=OneWay}" Command="{Binding ToggleSnapCommand}" />
        <Separator />
        <MenuItem Header="{Binding L10n.Menu_View_Language, Mode=OneWay}">
          <MenuItem Header="{Binding L10n.Menu_View_Language_System, Mode=OneWay}"
                    ToggleType="Radio"
                    IsChecked="{Binding L10n.IsSystemLanguage, Mode=OneWay}"
                    Command="{Binding SetLanguageCommand}"
                    CommandParameter="system" />
          <MenuItem Header="日本語"
                    ToggleType="Radio"
                    IsChecked="{Binding L10n.IsJapaneseLanguage, Mode=OneWay}"
                    Command="{Binding SetLanguageCommand}"
                    CommandParameter="ja" />
          <MenuItem Header="English"
                    ToggleType="Radio"
                    IsChecked="{Binding L10n.IsEnglishLanguage, Mode=OneWay}"
                    Command="{Binding SetLanguageCommand}"
                    CommandParameter="en" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{Binding L10n.Menu_Object, Mode=OneWay}">
        <MenuItem Header="{Binding L10n.Menu_Object_Group, Mode=OneWay}" InputGesture="Ctrl+G" Command="{Binding GroupSelectionCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Object_Ungroup, Mode=OneWay}" InputGesture="Ctrl+Shift+G" Command="{Binding UngroupSelectionCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Object_EnterGroup, Mode=OneWay}" InputGesture="Enter" Command="{Binding EnterGroupCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Object_ExitGroup, Mode=OneWay}" Command="{Binding ExitGroupCommand}" />
        <Separator />
        <MenuItem Header="{Binding L10n.Menu_Object_FlipHorizontal, Mode=OneWay}" InputGesture="Shift+H" Command="{Binding FlipHorizontalCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Object_FlipVertical, Mode=OneWay}" InputGesture="Shift+V" Command="{Binding FlipVerticalCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Object_Order, Mode=OneWay}">
          <MenuItem Header="{Binding L10n.Menu_Object_Order_Front, Mode=OneWay}" InputGesture="Home" Command="{Binding ChangeOrderCommand}" CommandParameter="front" />
          <MenuItem Header="{Binding L10n.Menu_Object_Order_Forward, Mode=OneWay}" InputGesture="PageUp" Command="{Binding ChangeOrderCommand}" CommandParameter="forward" />
          <MenuItem Header="{Binding L10n.Menu_Object_Order_Backward, Mode=OneWay}" InputGesture="PageDown" Command="{Binding ChangeOrderCommand}" CommandParameter="backward" />
          <MenuItem Header="{Binding L10n.Menu_Object_Order_Back, Mode=OneWay}" InputGesture="End" Command="{Binding ChangeOrderCommand}" CommandParameter="back" />
        </MenuItem>
        <MenuItem Header="{Binding L10n.Menu_Object_Align, Mode=OneWay}">
          <MenuItem Header="{Binding L10n.Menu_Object_Align_Left, Mode=OneWay}" Command="{Binding AlignSelectionCommand}" CommandParameter="left" />
          <MenuItem Header="{Binding L10n.Menu_Object_Align_CenterX, Mode=OneWay}" Command="{Binding AlignSelectionCommand}" CommandParameter="center-x" />
          <MenuItem Header="{Binding L10n.Menu_Object_Align_Right, Mode=OneWay}" Command="{Binding AlignSelectionCommand}" CommandParameter="right" />
          <MenuItem Header="{Binding L10n.Menu_Object_Align_Top, Mode=OneWay}" Command="{Binding AlignSelectionCommand}" CommandParameter="top" />
          <MenuItem Header="{Binding L10n.Menu_Object_Align_CenterY, Mode=OneWay}" Command="{Binding AlignSelectionCommand}" CommandParameter="center-y" />
          <MenuItem Header="{Binding L10n.Menu_Object_Align_Bottom, Mode=OneWay}" Command="{Binding AlignSelectionCommand}" CommandParameter="bottom" />
          <MenuItem Header="{Binding L10n.Menu_Object_Align_DistributeX, Mode=OneWay}" Command="{Binding AlignSelectionCommand}" CommandParameter="distribute-x" />
          <MenuItem Header="{Binding L10n.Menu_Object_Align_DistributeY, Mode=OneWay}" Command="{Binding AlignSelectionCommand}" CommandParameter="distribute-y" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{Binding L10n.Menu_Path, Mode=OneWay}">
        <MenuItem Header="{Binding L10n.Menu_Path_ObjectToPath, Mode=OneWay}" InputGesture="Ctrl+Shift+C" Command="{Binding ObjectToPathCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Path_StrokeToPath, Mode=OneWay}" InputGesture="Ctrl+Alt+C" Command="{Binding StrokeToPathCommand}" />
        <Separator />
        <MenuItem Header="{Binding L10n.Menu_Path_Union, Mode=OneWay}" InputGesture="Ctrl+Shift+U" Command="{Binding BooleanUnionActiveLayerShapesCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Path_Difference, Mode=OneWay}" InputGesture="Ctrl+Shift+D" Command="{Binding BooleanDifferenceActiveLayerShapesCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Path_Intersection, Mode=OneWay}" InputGesture="Ctrl+Shift+I" Command="{Binding BooleanIntersectionCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Path_Xor, Mode=OneWay}" InputGesture="Ctrl+Shift+X" Command="{Binding BooleanXorCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Path_ReverseDifference, Mode=OneWay}" InputGesture="Ctrl+Shift+R" Command="{Binding BooleanReverseDifferenceCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Path_ToggleClosed, Mode=OneWay}" InputGesture="Ctrl+K" Command="{Binding TogglePathClosedCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Path_Join, Mode=OneWay}" Command="{Binding JoinPathCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Path_Simplify, Mode=OneWay}" InputGesture="Ctrl+L" Command="{Binding SimplifyPathCommand}" />
      </MenuItem>
      <MenuItem Header="{Binding L10n.Menu_Layer, Mode=OneWay}">
        <MenuItem Header="{Binding L10n.Menu_Layer_New, Mode=OneWay}" InputGesture="Ctrl+Shift+N" Command="{Binding NewLayerCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Layer_Duplicate, Mode=OneWay}" Command="{Binding DuplicateLayerCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Layer_Delete, Mode=OneWay}" Command="{Binding DeleteLayerCommand}" />
        <MenuItem Header="{Binding L10n.Menu_Layer_RotateFlip, Mode=OneWay}">
          <MenuItem Header="{Binding L10n.Menu_Layer_Rotate90CW, Mode=OneWay}" Command="{Binding RotateLayerCommand}" CommandParameter="90" />
          <MenuItem Header="{Binding L10n.Menu_Layer_Rotate90CCW, Mode=OneWay}" Command="{Binding RotateLayerCommand}" CommandParameter="-90" />
          <MenuItem Header="{Binding L10n.Menu_Layer_Rotate180, Mode=OneWay}" Command="{Binding RotateLayerCommand}" CommandParameter="180" />
          <MenuItem Header="{Binding L10n.Menu_Object_FlipHorizontal, Mode=OneWay}" Command="{Binding RotateLayerCommand}" CommandParameter="flip-x" />
          <MenuItem Header="{Binding L10n.Menu_Object_FlipVertical, Mode=OneWay}" Command="{Binding RotateLayerCommand}" CommandParameter="flip-y" />
          <Separator />
          <MenuItem Header="{Binding L10n.Menu_Layer_RotateCustom, Mode=OneWay}" Command="{Binding OpenRotateLayerDialogCommand}" />
        </MenuItem>
        <MenuItem Header="{Binding L10n.Menu_Layer_BlendMode, Mode=OneWay}">
          <MenuItem Header="Normal" Command="{Binding SetLayerBlendCommand}" CommandParameter="{x:Static styling:LayerBlendMode.Normal}" />
          <MenuItem Header="Multiply" Command="{Binding SetLayerBlendCommand}" CommandParameter="{x:Static styling:LayerBlendMode.Multiply}" />
          <MenuItem Header="Screen" Command="{Binding SetLayerBlendCommand}" CommandParameter="{x:Static styling:LayerBlendMode.Screen}" />
          <MenuItem Header="Overlay" Command="{Binding SetLayerBlendCommand}" CommandParameter="{x:Static styling:LayerBlendMode.Overlay}" />
          <MenuItem Header="Add" Command="{Binding SetLayerBlendCommand}" CommandParameter="{x:Static styling:LayerBlendMode.Add}" />
          <MenuItem Header="Subtract" Command="{Binding SetLayerBlendCommand}" CommandParameter="{x:Static styling:LayerBlendMode.Subtract}" />
          <MenuItem Header="Difference" Command="{Binding SetLayerBlendCommand}" CommandParameter="{x:Static styling:LayerBlendMode.Difference}" />
          <MenuItem Header="Darken" Command="{Binding SetLayerBlendCommand}" CommandParameter="{x:Static styling:LayerBlendMode.Darken}" />
          <MenuItem Header="Lighten" Command="{Binding SetLayerBlendCommand}" CommandParameter="{x:Static styling:LayerBlendMode.Lighten}" />
        </MenuItem>
        <MenuItem Header="{Binding L10n.Menu_Layer_Order, Mode=OneWay}">
          <MenuItem Header="{Binding L10n.Menu_Object_Order_Front, Mode=OneWay}" Command="{Binding OrderLayerCommand}" CommandParameter="front" />
          <MenuItem Header="{Binding L10n.Menu_Object_Order_Forward, Mode=OneWay}" Command="{Binding OrderLayerCommand}" CommandParameter="forward" />
          <MenuItem Header="{Binding L10n.Menu_Object_Order_Backward, Mode=OneWay}" Command="{Binding OrderLayerCommand}" CommandParameter="backward" />
          <MenuItem Header="{Binding L10n.Menu_Object_Order_Back, Mode=OneWay}" Command="{Binding OrderLayerCommand}" CommandParameter="back" />
        </MenuItem>
        <MenuItem Header="{Binding L10n.Ui_MergeLayer, Mode=OneWay}" InputGesture="Ctrl+E" Command="{Binding MergeLayerDownCommand}" />
        <MenuItem Header="{Binding L10n.Ui_Visibility, Mode=OneWay}" Command="{Binding ToggleLayerVisibilityCommand}" />
        <MenuItem Header="{Binding L10n.Ui_Lock, Mode=OneWay}" Command="{Binding ToggleLayerLockCommand}" />
      </MenuItem>
      <MenuItem Header="{Binding L10n.Ui_Extensions, Mode=OneWay}">
        <MenuItem Header="{Binding L10n.Ui_BlurDialog, Mode=OneWay}" Command="{Binding OpenBlurInspectorCommand}" />
        <MenuItem Header="{Binding L10n.Ui_ToggleLayerBlur, Mode=OneWay}" Command="{Binding ToggleGaussianBlurOnActiveLayerCommand}" />
        <MenuItem Header="{Binding L10n.Ui_ClearFilters, Mode=OneWay}" Command="{Binding ClearFiltersCommand}" />
        <Separator />
        <MenuItem Header="{Binding L10n.Ui_ApplySksl, Mode=OneWay}" Command="{Binding OpenShaderInspectorCommand}" />
        <MenuItem Header="{Binding L10n.Ui_PluginCommands, Mode=OneWay}" ItemsSource="{Binding PluginMenus}">
          <MenuItem.ItemContainerTheme>
            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:PluginMenuItem">
              <Setter Property="Header" Value="{Binding Title}" />
              <Setter Property="Command" Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExecutePluginMenuCommand}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
            </ControlTheme>
          </MenuItem.ItemContainerTheme>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{Binding L10n.Menu_Help, Mode=OneWay}">
        <MenuItem Header="{Binding L10n.Menu_Help_About, Mode=OneWay}" Command="{Binding OpenAboutDialogCommand}" />
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,1" Padding="10,6">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="{Binding ActiveToolItem.Title}" FontWeight="SemiBold" Margin="0,0,10,0" />
        <controls:OverflowToolbar Grid.Column="1" Localization="{Binding L10n}">
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowRectangleInputs}">
            <TextBlock Text="X" /><controls:SafeNumericUpDown Value="{Binding GeometryX}" Minimum="-1000000" Maximum="1000000" Width="72" MinWidth="72" ShowButtonSpinner="False" />
            <TextBlock Text="Y" /><controls:SafeNumericUpDown Value="{Binding GeometryY}" Minimum="-1000000" Maximum="1000000" Width="72" MinWidth="72" ShowButtonSpinner="False" />
            <TextBlock Text="W" /><controls:SafeNumericUpDown Value="{Binding GeometryWidth}" Minimum="0.01" Maximum="1000000" Width="72" MinWidth="72" ShowButtonSpinner="False" />
            <TextBlock Text="H" /><controls:SafeNumericUpDown Value="{Binding GeometryHeight}" Minimum="0.01" Maximum="1000000" Width="72" MinWidth="72" ShowButtonSpinner="False" />
            <Button Content="{Binding L10n.Ui_Apply, Mode=OneWay}" Command="{Binding ApplyShapeDetailsCommand}" />
          </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowTransformInputs}"><TextBlock Text="X" /><controls:SafeNumericUpDown Value="{Binding SelectionX}" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><TextBlock Text="Y" /><controls:SafeNumericUpDown Value="{Binding SelectionY}" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><TextBlock Text="W" /><controls:SafeNumericUpDown Value="{Binding SelectionWidth}" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><TextBlock Text="H" /><controls:SafeNumericUpDown Value="{Binding SelectionHeight}" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><Button Content="{Binding L10n.Ui_Apply, Mode=OneWay}" Command="{Binding ApplyTransformCommand}" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsNodeTool}"><TextBlock Text="{Binding L10n.Ui_NodeX, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding NodeX}" AllowEmpty="True" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><TextBlock Text="Y" /><controls:SafeNumericUpDown Value="{Binding NodeY}" AllowEmpty="True" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><Button Content="{Binding L10n.Ui_Apply, Mode=OneWay}" Command="{Binding ApplyNodeCoordinatesCommand}" IsEnabled="{Binding HasSelectedAnchors}" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowRadialInputs}"><TextBlock Text="Cx" /><controls:SafeNumericUpDown Value="{Binding GeometryX}" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><TextBlock Text="Cy" /><controls:SafeNumericUpDown Value="{Binding GeometryY}" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><TextBlock Text="Rx" /><controls:SafeNumericUpDown Value="{Binding RadiusX}" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><TextBlock Text="Ry" /><controls:SafeNumericUpDown Value="{Binding RadiusY}" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><Button Content="{Binding L10n.Ui_Apply, Mode=OneWay}" Command="{Binding ApplyShapeDetailsCommand}" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowPolygonInputs}"><TextBlock Text="{Binding L10n.Ui_Sides, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding PolygonSides}" Minimum="3" Maximum="64" ShowButtonSpinner="False" MinWidth="72" Width="72" /><TextBlock Text="R" /><controls:SafeNumericUpDown Value="{Binding OuterRadius}" Minimum="0.01" Maximum="100000" ShowButtonSpinner="False" MinWidth="72" Width="72" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsTextTool}"><controls:FontPicker Localization="{Binding L10n}" LanguageSafety="{Binding LanguageSafety}" Value="{Binding FontFamily, Mode=TwoWay}" Families="{Binding InstalledFontFamilies}" Width="210" /><controls:SafeNumericUpDown Value="{Binding FontSize}" Minimum="1" Maximum="1000" ShowButtonSpinner="False" MinWidth="72" Width="72" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4"><Button Content="{Binding L10n.Ui_Fill, Mode=OneWay}" ToolTip.Tip="{Binding L10n.Ui_FillColor, Mode=OneWay}">
            <Button.Flyout><Flyout Placement="BottomEdgeAlignedLeft"><ScrollViewer MaxHeight="650" HorizontalScrollBarVisibility="Disabled"><controls:PaintEditor DataContext="{Binding FillPaintEditor}" Width="300" /></ScrollViewer></Flyout></Button.Flyout>
          </Button>
          <TextBox Text="{Binding FillColorDisplay}" Width="90" Watermark="{Binding L10n.Ui_Mixed, Mode=OneWay}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4"><Button Content="{Binding L10n.Ui_Stroke, Mode=OneWay}" ToolTip.Tip="{Binding L10n.Ui_StrokeColor, Mode=OneWay}">
            <Button.Flyout><Flyout Placement="BottomEdgeAlignedLeft"><ScrollViewer MaxHeight="650" HorizontalScrollBarVisibility="Disabled"><controls:PaintEditor DataContext="{Binding StrokePaintEditor}" Width="300" /></ScrollViewer></Flyout></Button.Flyout>
          </Button>
          <TextBox Text="{Binding StrokeColor}" Width="90" Watermark="{Binding L10n.Ui_Mixed, Mode=OneWay}" />
          <controls:SafeNumericUpDown Value="{Binding StrokeWidth}" AllowEmpty="True" Minimum="0" Maximum="1000" Increment="0.5" ToolTip.Tip="{Binding L10n.Ui_StrokeWidthHint, Mode=OneWay}" Width="82" MinWidth="82" ShowButtonSpinner="False" />
        </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsRectangleTool}"><TextBlock Text="{Binding L10n.Ui_RadiusX, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding CornerRadius}" Minimum="0" Maximum="1000" Width="82" MinWidth="82" ShowButtonSpinner="False" />
                      </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsRectangleTool}"><TextBlock Text="{Binding L10n.Ui_RadiusY, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding CornerRadiusY}" Minimum="0" Maximum="1000" Width="82" MinWidth="82" ShowButtonSpinner="False" />
                      </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsRectangleTool}"><CheckBox Content="{Binding L10n.Ui_LinkRadii, Mode=OneWay}" IsChecked="{Binding LinkCorners}" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsRectangleTool}"><Button Content="{Binding L10n.Ui_ResetCorners, Mode=OneWay}" Command="{Binding ResetCornersCommand}" />
                    </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsPolygonTool}"><TextBlock Text="{Binding L10n.Ui_VertexCount, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding PolygonSides}" Minimum="3" Maximum="64" Increment="1" FormatString="0" Width="82" MinWidth="82" ShowButtonSpinner="False" />
                      </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsStarTool}"><TextBlock Text="{Binding L10n.Ui_InnerRatio, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding InnerRatio}" Minimum="0.05" Maximum="0.95" Increment="0.05" Width="82" MinWidth="82" ShowButtonSpinner="False" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsArcTool}"><ComboBox ItemsSource="{Binding ArcChoices}" ItemTemplate="{StaticResource LocalizedChoiceTemplate}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding ArcMode, Mode=TwoWay}" />
                      </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsArcTool}"><TextBlock Text="{Binding L10n.Ui_StartAngle, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding ArcStart}" Minimum="-360" Maximum="360" Width="82" MinWidth="82" ShowButtonSpinner="False" />
                      </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsArcTool}"><TextBlock Text="{Binding L10n.Ui_Sweep, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding ArcSweep}" Minimum="-360" Maximum="360" Width="82" MinWidth="82" ShowButtonSpinner="False" />
                    </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsFreehandTool}"><TextBlock Text="{Binding L10n.Ui_Smoothing, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding Smoothing}" Minimum="0" Maximum="100" Width="82" MinWidth="82" ShowButtonSpinner="False" />
                      </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsFreehandTool}"><CheckBox Content="{Binding L10n.Ui_CloseAfterDraw, Mode=OneWay}" IsChecked="{Binding CloseFreehand}" />
                    </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsBezierTool}"><CheckBox Content="{Binding L10n.Ui_Polyline, Mode=OneWay}" IsChecked="{Binding BezierPolyline}" />
                      </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsBezierTool}"><Button Content="{Binding L10n.Ui_FinishOpen, Mode=OneWay}" Command="{Binding FinishBezierCommand}" />
                      </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsBezierTool}"><Button Content="{Binding L10n.Ui_CloseFinish, Mode=OneWay}" Command="{Binding CloseBezierCommand}" />
                    </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsNodeTool}"><Button Content="{Binding L10n.Ui_AddMidpoint, Mode=OneWay}" Command="{Binding AddNodeCommand}" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsNodeTool}"><Button Content="{Binding L10n.Ui_DeleteNode, Mode=OneWay}" Command="{Binding DeleteNodeCommand}" />
                        </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsNodeTool}"><Button Content="{Binding L10n.Ui_Corner, Mode=OneWay}" Command="{Binding CornerNodeCommand}" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsNodeTool}"><Button Content="{Binding L10n.Ui_Smooth, Mode=OneWay}" Command="{Binding SmoothNodeCommand}" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsNodeTool}"><Button Content="{Binding L10n.Ui_Symmetric, Mode=OneWay}" Command="{Binding SymmetricNodeCommand}" />
                        </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsNodeTool}"><Button Content="{Binding L10n.Ui_Straight, Mode=OneWay}" Command="{Binding StraightSegmentCommand}" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsNodeTool}"><Button Content="{Binding L10n.Ui_Curve, Mode=OneWay}" Command="{Binding CurvedSegmentCommand}" />
                        </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsNodeTool}"><Button Content="{Binding L10n.Ui_JoinEndpoints, Mode=OneWay}" Command="{Binding JoinPathCommand}" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsNodeTool}"><Button Content="{Binding L10n.Ui_CutNodes, Mode=OneWay}" Command="{Binding CutPathCommand}" />
                        </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsNodeTool}"><Button Content="{Binding L10n.Ui_ToggleClosed, Mode=OneWay}" Command="{Binding TogglePathClosedCommand}" />
                      </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsNodeTool}"><TextBlock Text="{Binding L10n.Ui_Tolerance, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding SimplifyTolerance}" Minimum="0.1" Maximum="50" Increment="0.5" Width="82" MinWidth="82" ShowButtonSpinner="False" />
                      </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsNodeTool}"><Button Content="{Binding L10n.Ui_Simplify, Mode=OneWay}" Command="{Binding SimplifyPathCommand}" />
                    </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsTextTool}"><ToggleButton Content="{Binding L10n.Ui_Bold, Mode=OneWay}" IsChecked="{Binding TextBold}" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsTextTool}"><ToggleButton Content="{Binding L10n.Ui_Italic, Mode=OneWay}" IsChecked="{Binding TextItalic}" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsTextTool}"><ComboBox ItemsSource="{Binding AlignmentChoices}" ItemTemplate="{StaticResource LocalizedChoiceTemplate}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding TextAlignment, Mode=TwoWay}" />
                      </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsTextTool}"><TextBlock Text="{Binding L10n.Ui_LetterSpacing, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding LetterSpacing}" Minimum="-100" Maximum="1000" Width="82" MinWidth="82" ShowButtonSpinner="False" />
                      </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasSelection}"><TextBlock Text="{Binding L10n.Ui_SkewX, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding ShearX}" Minimum="-85" Maximum="85" Width="82" MinWidth="82" ShowButtonSpinner="False" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasSelection}"><TextBlock Text="{Binding L10n.Ui_SkewY, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding ShearY}" Minimum="-85" Maximum="85" Width="82" MinWidth="82" ShowButtonSpinner="False" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasSelection}"><Button Content="{Binding L10n.Ui_ApplyTransform, Mode=OneWay}" Command="{Binding ApplyTransformCommand}" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="{Binding L10n.Ui_LayerAngle, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding LayerAngle}" Minimum="-360" Maximum="360" Width="82" MinWidth="82" ShowButtonSpinner="False" /><Button Content="{Binding L10n.Ui_RotateLayer, Mode=OneWay}" Command="{Binding RotateLayerCommand}" CommandParameter="custom" />
                    </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="{Binding L10n.Ui_LineStyle, Mode=OneWay}" /><ComboBox ItemsSource="{Binding DashChoices}" ItemTemplate="{StaticResource LocalizedChoiceTemplate}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding StrokeDash, Mode=TwoWay}" PlaceholderText="{Binding L10n.Ui_MixedCustom, Mode=OneWay}" />
                  </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasRadialShape}"><TextBlock Text="{Binding L10n.Ui_Shape, Mode=OneWay}" /><ComboBox ItemsSource="{Binding EllipseChoices}" ItemTemplate="{StaticResource LocalizedChoiceTemplate}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding EllipseMode, Mode=TwoWay}" /><Button Content="{Binding L10n.Ui_ApplyShape, Mode=OneWay}" Command="{Binding ApplyShapeDetailsCommand}" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasParametricPolygon}"><TextBlock Text="{Binding L10n.Ui_CenterX, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding GeometryX}" Minimum="-1000000" Maximum="1000000" Width="82" MinWidth="82" ShowButtonSpinner="False" /><TextBlock Text="Y" /><controls:SafeNumericUpDown Value="{Binding GeometryY}" Minimum="-1000000" Maximum="1000000" Width="82" MinWidth="82" ShowButtonSpinner="False" /><ComboBox ItemsSource="{Binding PolygonModes}" SelectedItem="{Binding PolygonMode}" /><Button Content="{Binding L10n.Ui_ApplyShape, Mode=OneWay}" Command="{Binding ApplyShapeDetailsCommand}" /></StackPanel>
        </controls:OverflowToolbar>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="10,6">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto">
        <TextBlock Text="{Binding CursorPosition}" MinWidth="105" FontSize="12" />
        <TextBlock Grid.Column="1" Text="{Binding SelectionSummary}" Margin="12,0" FontSize="12" />
        <TextBlock Grid.Column="2" Text="{Binding ToolHint}" TextTrimming="CharacterEllipsis" Foreground="#94A3B8" FontSize="12" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
          <ToggleButton Content="{Binding L10n.Ui_Grid, Mode=OneWay}" IsChecked="{Binding ShowGrid}" />
          <ToggleButton Content="{Binding L10n.Ui_Snap, Mode=OneWay}" IsChecked="{Binding SnapToGrid}" ToolTip.Tip="{Binding L10n.Ui_SnapHint, Mode=OneWay}" />
          <Button Content="−" Command="{Binding ZoomOutCommand}" /><Button Content="{Binding ZoomLabel}" Command="{Binding ResetZoomCommand}" /><Button Content="+" Command="{Binding ZoomInCommand}" />
        </StackPanel>
        <Grid Grid.Row="1" Grid.ColumnSpan="4" ColumnDefinitions="*,Auto" Margin="0,3,0,0">
          <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Text="{Binding PendingLanguageNotice}" IsVisible="{Binding HasPendingLanguage}" Foreground="#94A3B8" FontSize="11" Margin="12,0,0,0" />
        </Grid>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Left" Width="58" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <ListBox Classes="tools" ItemsSource="{Binding Tools}" SelectedItem="{Binding ActiveToolItem}" Background="Transparent" SelectionMode="Single">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ToolItem">
                <controls:ToolIcon Icon="{Binding Icon}" Width="24" Height="24" ToolTip.Tip="{Binding Hint}" AutomationProperties.Name="{Binding Title}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Separator Margin="6,8" />
          <ItemsControl ItemsSource="{Binding PluginToolbarItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PluginToolbarItem">
                <Button Content="+" Margin="7,3" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Tooltip}" AutomationProperties.Name="{Binding Title}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExecutePluginToolbarItemCommand}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Grid x:Name="EditorLayout">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320" /><ColumnDefinition Width="5" /><ColumnDefinition Width="300" MinWidth="240" MaxWidth="650" /></Grid.ColumnDefinitions>
    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#30363D" ResizeDirection="Columns" />
    <Border Grid.Column="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1,0,0,0" Padding="6">
      <Grid RowDefinitions="3*,4,2*">
        <TabControl Grid.Row="0" Padding="4" SelectedIndex="{Binding SelectedInspectorTab}">
          <TabItem Header="{Binding L10n.Ui_FillStroke, Mode=OneWay}" FontSize="13" MinWidth="150">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10" Margin="0,4,4,8">
                <TextBlock Text="{Binding StyleTargetDisplay}" FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold" />
                <Expander Header="{Binding L10n.Ui_FillDetails, Mode=OneWay}" IsExpanded="True" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="8">
                    <controls:PaintEditor DataContext="{Binding FillPaintEditor}" />
                    <StackPanel Spacing="6" IsVisible="{Binding IsTextureFill}">
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="{Binding L10n.Ui_Pattern, Mode=OneWay}" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding TextureChoices}" ItemTemplate="{StaticResource LocalizedChoiceTemplate}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding TexturePattern, Mode=TwoWay}" PlaceholderText="{Binding L10n.Ui_Mixed, Mode=OneWay}" />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{Binding L10n.Ui_Primary, Mode=OneWay}" />
                        <TextBox Grid.Column="1" Text="{Binding TexturePrimaryColor}" Watermark="{Binding L10n.Ui_Mixed, Mode=OneWay}" Margin="0,0,4,0" />
                        <Button Grid.Column="2" Content="{Binding L10n.Ui_Color, Mode=OneWay}">
                          <Button.Flyout>
                            <Flyout>
                              <ItemsControl ItemsSource="{Binding ColorSwatches}" Width="180">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ColorSwatch">
                                    <Button Width="26" Height="26" Margin="2" Background="{Binding Brush}" ToolTip.Tip="{Binding Value}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetTexturePrimaryColorCommand}" CommandParameter="{Binding Value}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{Binding L10n.Ui_Secondary, Mode=OneWay}" />
                        <TextBox Grid.Column="1" Text="{Binding TextureSecondaryColor}" Watermark="{Binding L10n.Ui_Mixed, Mode=OneWay}" Margin="0,0,4,0" />
                        <Button Grid.Column="2" Content="{Binding L10n.Ui_Color, Mode=OneWay}">
                          <Button.Flyout>
                            <Flyout>
                              <ItemsControl ItemsSource="{Binding ColorSwatches}" Width="180">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ColorSwatch">
                                    <Button Width="26" Height="26" Margin="2" Background="{Binding Brush}" ToolTip.Tip="{Binding Value}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetTextureSecondaryColorCommand}" CommandParameter="{Binding Value}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                      </Grid>
                      <TextBlock Text="{Binding L10n.Ui_TextureScale, Mode=OneWay}" />
                      <Grid ColumnDefinitions="*,140">
                        <Slider Minimum="4" Maximum="128" Value="{Binding TextureScale, Converter={StaticResource NullableDecimalToDoubleConverter}}" Margin="0,0,6,0" />
                        <controls:SafeNumericUpDown Grid.Column="1" Minimum="4" Maximum="128" Increment="2" Value="{Binding TextureScale}" AllowEmpty="True" MinWidth="140" />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="{Binding L10n.Ui_Angle, Mode=OneWay}" />
                        <controls:SafeNumericUpDown Grid.Column="1" Minimum="-180" Maximum="180" Increment="15" Value="{Binding TextureAngle}" AllowEmpty="True" />
                      </Grid>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsTextureFill}" Spacing="6">
                    <TextBlock Text="{Binding L10n.Ui_FillOpacity, Mode=OneWay}" />
                    <Grid ColumnDefinitions="*,140">
                      <Slider Minimum="0" Maximum="100" Value="{Binding FillOpacity, Converter={StaticResource NullableDecimalToDoubleConverter}}" Margin="0,0,6,0" />
                      <controls:SafeNumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="5" Value="{Binding FillOpacity}" AllowEmpty="True" MinWidth="140" />
                    </Grid>
                    </StackPanel>
                  </StackPanel>
                </Expander>

                <Expander Header="{Binding L10n.Ui_StrokeDetails, Mode=OneWay}" IsExpanded="True" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="8">
                    <controls:PaintEditor DataContext="{Binding StrokePaintEditor}" />
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="{Binding L10n.Ui_StrokeWidth, Mode=OneWay}" />
                      <controls:SafeNumericUpDown Grid.Column="1" Minimum="0" Maximum="1000" Increment="0.5" Value="{Binding StrokeWidth}" AllowEmpty="True" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="{Binding L10n.Ui_Cap, Mode=OneWay}" />
                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding CapChoices}" ItemTemplate="{StaticResource LocalizedChoiceTemplate}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding StrokeCap, Mode=TwoWay}" PlaceholderText="{Binding L10n.Ui_Mixed, Mode=OneWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="{Binding L10n.Ui_Join, Mode=OneWay}" />
                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding JoinChoices}" ItemTemplate="{StaticResource LocalizedChoiceTemplate}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding StrokeJoin, Mode=TwoWay}" PlaceholderText="{Binding L10n.Ui_Mixed, Mode=OneWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="{Binding L10n.Ui_MiterLimit, Mode=OneWay}" />
                      <controls:SafeNumericUpDown Grid.Column="1" Minimum="1" Maximum="100" Increment="0.5" Value="{Binding StrokeMiterLimit}" AllowEmpty="True" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="{Binding L10n.Ui_DashKind, Mode=OneWay}" />
                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding DashChoices}" ItemTemplate="{StaticResource LocalizedChoiceTemplate}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding StrokeDash, Mode=TwoWay}" PlaceholderText="{Binding L10n.Ui_Mixed, Mode=OneWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Text="{Binding L10n.Ui_DashArray, Mode=OneWay}" />
                      <TextBox Grid.Column="1" Text="{Binding CustomDashArray}" Watermark="{Binding L10n.Ui_DashExample, Mode=OneWay}" Margin="0,0,4,0" />
                      <Button Grid.Column="2" Content="{Binding L10n.Ui_Apply, Mode=OneWay}" Command="{Binding ApplyCustomDashCommand}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="{Binding L10n.Ui_DashPhase, Mode=OneWay}" />
                      <controls:SafeNumericUpDown Grid.Column="1" Minimum="-1000" Maximum="1000" Increment="1" Value="{Binding StrokeDashPhase}" AllowEmpty="True" />
                    </Grid>
                  </StackPanel>
                </Expander>

                <Expander Header="{Binding L10n.Ui_Transform, Mode=OneWay}" IsExpanded="False" IsVisible="{Binding HasSelection}" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="6">
                    <TextBlock Text="X" /><controls:SafeNumericUpDown Value="{Binding SelectionX}" Minimum="-1000000" Maximum="1000000" />
                    <TextBlock Text="Y" /><controls:SafeNumericUpDown Value="{Binding SelectionY}" Minimum="-1000000" Maximum="1000000" />
                    <TextBlock Text="{Binding L10n.Ui_Width, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding SelectionWidth}" Minimum="0.01" Maximum="1000000" />
                    <TextBlock Text="{Binding L10n.Ui_Height, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding SelectionHeight}" Minimum="0.01" Maximum="1000000" />
                    <CheckBox Content="{Binding L10n.Ui_LockAspect, Mode=OneWay}" IsChecked="{Binding LockAspect}" />
                    <TextBlock Text="{Binding L10n.Ui_ExtraRotation, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding SelectionRotation}" Minimum="-360" Maximum="360" />
                    <Button Content="{Binding L10n.Ui_ApplyTransform, Mode=OneWay}" Command="{Binding ApplyTransformCommand}" />
                  </StackPanel>
                </Expander>

                <Expander Header="{Binding L10n.Ui_PolygonParams, Mode=OneWay}" IsVisible="{Binding HasParametricPolygon}" IsExpanded="True" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding L10n.Ui_Sides, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding PolygonSides}" Minimum="3" Maximum="64" FormatString="0" />
                    <TextBlock Text="{Binding L10n.Ui_OuterRadius, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding OuterRadius}" Minimum="0.01" Maximum="100000" />
                    <StackPanel IsVisible="{Binding HasStarPolygon}"><TextBlock Text="{Binding L10n.Ui_StarRatio, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding InnerRatio}" Minimum="0.05" Maximum="0.95" Increment="0.05" /></StackPanel>
                    <TextBlock Text="{Binding L10n.Ui_StartAngle, Mode=OneWay}" /><controls:SafeNumericUpDown Value="{Binding PolygonAngle}" Minimum="-360" Maximum="360" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{Binding L10n.Ui_Effects, Mode=OneWay}" FontSize="13" MinWidth="150">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10" Margin="0,4,4,8">
                <TextBlock Text="{Binding EffectTargetDisplay}" FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold" />

                <Expander Header="{Binding L10n.Ui_Compositing, Mode=OneWay}" IsExpanded="True" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding L10n.Ui_Opacity, Mode=OneWay}" />
                    <Grid ColumnDefinitions="*,140">
                      <Slider Minimum="0" Maximum="100" Value="{Binding EffectOpacity, Converter={StaticResource NullableDecimalToDoubleConverter}}" Margin="0,0,6,0" />
                      <controls:SafeNumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="5" Value="{Binding EffectOpacity}" AllowEmpty="True" MinWidth="140" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="{Binding L10n.Ui_BlendMode, Mode=OneWay}" />
                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding BlendChoices}" ItemTemplate="{StaticResource LocalizedChoiceTemplate}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding EffectBlendMode, Mode=TwoWay}" PlaceholderText="{Binding L10n.Ui_Mixed, Mode=OneWay}" />
                    </Grid>
                  </StackPanel>
                </Expander>

                <Expander Header="{Binding L10n.Ui_GaussianBlur, Mode=OneWay}" IsExpanded="True" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="8">
                    <CheckBox Content="{Binding L10n.Ui_EnableBlur, Mode=OneWay}" IsChecked="{Binding IsBlurEnabled}" />
                    <TextBlock Text="{Binding L10n.Ui_BlurX, Mode=OneWay}" />
                    <Grid ColumnDefinitions="*,140">
                      <Slider Minimum="0" Maximum="100" Value="{Binding BlurSigmaX, Converter={StaticResource NullableDecimalToDoubleConverter}}" Margin="0,0,6,0" />
                      <controls:SafeNumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="0.5" Value="{Binding BlurSigmaX}" AllowEmpty="True" MinWidth="140" />
                    </Grid>
                    <TextBlock Text="{Binding L10n.Ui_BlurY, Mode=OneWay}" />
                    <Grid ColumnDefinitions="*,140">
                      <Slider Minimum="0" Maximum="100" Value="{Binding BlurSigmaY, Converter={StaticResource NullableDecimalToDoubleConverter}}" Margin="0,0,6,0" />
                      <controls:SafeNumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="0.5" Value="{Binding BlurSigmaY}" AllowEmpty="True" MinWidth="140" />
                    </Grid>
                    <CheckBox Content="{Binding L10n.Ui_LinkBlur, Mode=OneWay}" IsChecked="{Binding LinkBlurSigma}" />
                    <Button Content="{Binding L10n.Ui_ClearFilters, Mode=OneWay}" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                </Expander>

                <Expander Header="{Binding L10n.Ui_Sksl, Mode=OneWay}" IsExpanded="True" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="{Binding L10n.Ui_Shader, Mode=OneWay}" />
                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding ShaderOptions}" ItemTemplate="{StaticResource ShaderOptionTemplate}" SelectedItem="{Binding SelectedShaderOption}" PlaceholderText="{Binding L10n.Ui_Mixed, Mode=OneWay}" />
                    </Grid>

                    <StackPanel Spacing="6" IsVisible="{Binding HasActiveShader}">
                      <TextBlock Text="{Binding L10n.Ui_Uniforms, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" Foreground="#94A3B8" />
                      <ItemsControl ItemsSource="{Binding ShaderUniforms}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ShaderUniformItem">
                            <StackPanel Spacing="3" Margin="0,2">
                              <TextBlock Text="{Binding Name}" FontSize="12" />
                              <Grid ColumnDefinitions="*,140">
                                <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" Margin="0,0,6,0" />
                                <controls:SafeNumericUpDown Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Increment="{Binding Increment}" Value="{Binding Value}" MinWidth="140" />
                              </Grid>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Expander Header="{Binding L10n.Ui_LiveSksl, Mode=OneWay}" IsExpanded="False" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="6">
                          <TextBox Text="{Binding SkslSourceCode}" AcceptsReturn="True" TextWrapping="NoWrap" Height="150" FontFamily="Consolas, Monospace" FontSize="12" />
                          <Button Content="{Binding L10n.Ui_CompileSksl, Mode=OneWay}" Command="{Binding CompileAndApplySkslCommand}" HorizontalAlignment="Stretch" />
                          <Border IsVisible="{Binding HasSkslError}" Background="#3B1219" BorderBrush="#F87171" BorderThickness="1" Padding="6" CornerRadius="4">
                            <TextBlock Text="{Binding SkslCompileError}" Foreground="#FCA5A5" TextWrapping="Wrap" FontSize="11" />
                          </Border>
                        </StackPanel>
                      </Expander>
                    </StackPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#30363D" />

        <DockPanel Grid.Row="2" Margin="4,6,4,0">
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding L10n.Ui_Layers, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                <Button Content="＋" Padding="6,2" ToolTip.Tip="{Binding L10n.Ui_NewLayerHint, Mode=OneWay}" Command="{Binding NewLayerCommand}" />
                <Button Content="{Binding L10n.Ui_Duplicate, Mode=OneWay}" Padding="6,2" ToolTip.Tip="{Binding L10n.Ui_DuplicateLayer, Mode=OneWay}" Command="{Binding DuplicateLayerCommand}" />
                <Button Content="{Binding L10n.Ui_Rotate, Mode=OneWay}" Padding="6,2" ToolTip.Tip="{Binding L10n.Ui_LayerTransforms, Mode=OneWay}">
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem Header="{Binding L10n.Ui_RotateCW, Mode=OneWay}" Command="{Binding RotateLayerCommand}" CommandParameter="90" />
                      <MenuItem Header="{Binding L10n.Ui_RotateCCW, Mode=OneWay}" Command="{Binding RotateLayerCommand}" CommandParameter="-90" />
                      <MenuItem Header="{Binding L10n.Ui_Rotate180, Mode=OneWay}" Command="{Binding RotateLayerCommand}" CommandParameter="180" />
                      <MenuItem Header="{Binding L10n.Ui_FlipHorizontal, Mode=OneWay}" Command="{Binding RotateLayerCommand}" CommandParameter="flip-x" />
                      <MenuItem Header="{Binding L10n.Ui_FlipVertical, Mode=OneWay}" Command="{Binding RotateLayerCommand}" CommandParameter="flip-y" />
                      <Separator />
                      <MenuItem Header="{Binding L10n.Ui_RotateCustom, Mode=OneWay}" Command="{Binding OpenRotateLayerDialogCommand}" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
                <Button Content="{Binding L10n.Ui_Merge, Mode=OneWay}" Padding="6,2" ToolTip.Tip="{Binding L10n.Ui_MergeLayerHint, Mode=OneWay}" Command="{Binding MergeLayerDownCommand}" />
                <Button Content="🗑" Padding="6,2" ToolTip.Tip="{Binding L10n.Ui_DeleteTarget, Mode=OneWay}" Command="{Binding DeleteTreeTargetCommand}" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="Auto,105,Auto,*" Margin="0,2,0,0">
              <TextBlock Text="{Binding L10n.Ui_BlendShort, Mode=OneWay}" FontSize="11" Foreground="#94A3B8" Margin="0,0,4,0" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding BlendChoices}" ItemTemplate="{StaticResource LocalizedChoiceTemplate}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding EffectBlendMode, Mode=TwoWay}" PlaceholderText="{Binding L10n.Ui_Mixed, Mode=OneWay}" FontSize="11" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Column="2" Text="{Binding L10n.Ui_OpacityShort, Mode=OneWay}" FontSize="11" Foreground="#94A3B8" Margin="8,0,4,0" />
              <Slider Grid.Column="3" Minimum="0" Maximum="100" Value="{Binding EffectOpacity, Converter={StaticResource NullableDecimalToDoubleConverter}}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>

          <TreeView x:Name="SceneHierarchyTree"
                    ItemsSource="{Binding SceneTree}"
                    SelectedItem="{Binding SelectedTreeItem, Mode=TwoWay}"
                    Background="Transparent"
                    DragDrop.AllowDrop="True">
            <TreeView.ItemContainerTheme>
              <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}" x:DataType="vm:SceneTreeItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              </ControlTheme>
            </TreeView.ItemContainerTheme>
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="vm:SceneTreeItem" ItemsSource="{Binding Children}">
                <Border Background="Transparent" Padding="2,1" DragDrop.AllowDrop="True">
                  <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                    <Button Grid.Column="0" Content="{Binding VisibilityIcon}" Padding="4,1" Background="Transparent" FontSize="11"
                            ToolTip.Tip="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L10n.Ui_ToggleVisibility, Mode=OneWay}"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleNodeVisibilityCommand}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Column="1" Content="{Binding LockIcon}" Padding="4,1" Background="Transparent" FontSize="11"
                            ToolTip.Tip="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L10n.Ui_ToggleLock, Mode=OneWay}"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleNodeLockCommand}"
                            CommandParameter="{Binding}" />
                    <TextBlock Grid.Column="2" Text="{Binding KindIcon}" Margin="4,0" FontSize="12" />
                    <Panel Grid.Column="3">
                      <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsEditingName}" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L10n.Ui_TreeHint, Mode=OneWay}" />
                      <TextBox Text="{Binding EditingNameText, Mode=TwoWay}" IsVisible="{Binding IsEditingName}" Padding="3,1" MinHeight="22" FontSize="12" />
                    </Panel>
                    <TextBlock Grid.Column="4" Text="{Binding EffectBadge}" IsVisible="{Binding HasEffectBadge}" Foreground="#F59E0B" FontSize="11" Margin="4,0,0,0" />
                    <TextBlock Grid.Column="5" Text="{Binding BlendBadge}" IsVisible="{Binding HasBlendBadge}" Foreground="#38BDF8" FontSize="11" Margin="4,0,0,0" />
                  </Grid>
                </Border>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Grid>
    </Border>
    <DockPanel Grid.Column="0">
      <Border DockPanel.Dock="Top" Background="#161B22" Padding="8,3" IsVisible="{Binding IsInGroup}">
        <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="{Binding L10n.Ui_Parent, Mode=OneWay}" Command="{Binding ExitGroupCommand}" /><TextBlock Text="{Binding ScopePath}" /></StackPanel>
      </Border>
    <controls:VectorCanvasControl Workspace="{Binding}" RenderVersion="{Binding RenderVersion}" />
    </DockPanel>
    </Grid>
  </DockPanel>
</Window>

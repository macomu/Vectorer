<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Vectorer.App.ViewModels"
        xmlns:controls="using:Vectorer.App.Controls"
        xmlns:plugins="using:Vectorer.Abstractions.Plugins"
        xmlns:docs="using:Vectorer.Abstractions.Documents"
        xmlns:styling="using:Vectorer.Abstractions.Styling"
        x:Class="Vectorer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800" MinWidth="1024" MinHeight="720"
        Background="#0D1117">
  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="NumericUpDown"><Setter Property="MinWidth" Value="115" /><Setter Property="FormatString" Value="0.##" /></Style>
    <Style Selector="ListBox.tools ListBoxItem"><Setter Property="Padding" Value="8" /><Setter Property="Margin" Value="3,2" /><Setter Property="HorizontalContentAlignment" Value="Center" /></Style>
  </Window.Styles>
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveDocumentAsCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding DocumentPropertiesCommand}" />
  </Window.KeyBindings>
  <DockPanel IsEnabled="{Binding !IsBusy}">
    <Menu DockPanel.Dock="Top" Background="#161B22">
      <MenuItem Header="ファイル">
        <MenuItem Header="新規" InputGesture="Ctrl+N" Command="{Binding NewDocumentCommand}" />
        <MenuItem Header="開く…" InputGesture="Ctrl+O" Command="{Binding OpenDocumentCommand}" />
        <MenuItem Header="保存" InputGesture="Ctrl+S" Command="{Binding SaveDocumentCommand}" />
        <MenuItem Header="名前を付けて保存…" InputGesture="Ctrl+Shift+S" Command="{Binding SaveDocumentAsCommand}" />
        <Separator /><MenuItem Header="ドキュメント設定…" InputGesture="Ctrl+Shift+P" Command="{Binding DocumentPropertiesCommand}" />
        <MenuItem Header="終了" InputGesture="Alt+F4" Command="{Binding ExitApplicationCommand}" />
      </MenuItem>
      <MenuItem Header="編集">
        <MenuItem Header="元に戻す" InputGesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <MenuItem Header="やり直し" InputGesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
        <Separator />
        <MenuItem Header="切り取り" InputGesture="Ctrl+X" Command="{Binding CutSelectionCommand}" />
        <MenuItem Header="コピー" InputGesture="Ctrl+C" Command="{Binding CopySelectionCommand}" />
        <MenuItem Header="貼り付け" InputGesture="Ctrl+V" Command="{Binding PasteCommand}" />
        <MenuItem Header="複製" InputGesture="Ctrl+D" Command="{Binding DuplicateSelectionCommand}" />
        <MenuItem Header="削除" InputGesture="Delete" Command="{Binding DeleteSelectionCommand}" />
        <Separator /><MenuItem Header="すべて選択" InputGesture="Ctrl+A" Command="{Binding SelectAllCommand}" />
      </MenuItem>
      <MenuItem Header="表示">
        <MenuItem Header="拡大" InputGesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
        <MenuItem Header="縮小" InputGesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
        <MenuItem Header="100%" InputGesture="Ctrl+1" Command="{Binding ResetZoomCommand}" />
        <MenuItem Header="キャンバス全体を表示" InputGesture="Ctrl+0" Command="{Binding FitCanvasCommand}" />
        <MenuItem Header="グリッド表示切替" Command="{Binding ToggleGridCommand}" />
        <MenuItem Header="スナップ切替" Command="{Binding ToggleSnapCommand}" />
      </MenuItem>
      <MenuItem Header="オブジェクト">
        <MenuItem Header="グループ化" InputGesture="Ctrl+G" Command="{Binding GroupSelectionCommand}" />
        <MenuItem Header="グループ解除" InputGesture="Ctrl+Shift+G" Command="{Binding UngroupSelectionCommand}" />
        <MenuItem Header="グループ内を編集" InputGesture="Enter" Command="{Binding EnterGroupCommand}" />
        <MenuItem Header="親階層へ戻る" Command="{Binding ExitGroupCommand}" />
        <Separator />
        <MenuItem Header="左右反転" InputGesture="Shift+H" Command="{Binding FlipHorizontalCommand}" />
        <MenuItem Header="上下反転" InputGesture="Shift+V" Command="{Binding FlipVerticalCommand}" />
        <MenuItem Header="重ね順">
          <MenuItem Header="最前面" InputGesture="Home" Command="{Binding ChangeOrderCommand}" CommandParameter="front" />
          <MenuItem Header="前面へ" InputGesture="PageUp" Command="{Binding ChangeOrderCommand}" CommandParameter="forward" />
          <MenuItem Header="背面へ" InputGesture="PageDown" Command="{Binding ChangeOrderCommand}" CommandParameter="backward" />
          <MenuItem Header="最背面" InputGesture="End" Command="{Binding ChangeOrderCommand}" CommandParameter="back" />
        </MenuItem>
        <MenuItem Header="整列と分布">
          <MenuItem Header="左揃え" Command="{Binding AlignSelectionCommand}" CommandParameter="left" />
          <MenuItem Header="左右中央" Command="{Binding AlignSelectionCommand}" CommandParameter="center-x" />
          <MenuItem Header="右揃え" Command="{Binding AlignSelectionCommand}" CommandParameter="right" />
          <MenuItem Header="上揃え" Command="{Binding AlignSelectionCommand}" CommandParameter="top" />
          <MenuItem Header="上下中央" Command="{Binding AlignSelectionCommand}" CommandParameter="center-y" />
          <MenuItem Header="下揃え" Command="{Binding AlignSelectionCommand}" CommandParameter="bottom" />
          <MenuItem Header="横に等間隔" Command="{Binding AlignSelectionCommand}" CommandParameter="distribute-x" />
          <MenuItem Header="縦に等間隔" Command="{Binding AlignSelectionCommand}" CommandParameter="distribute-y" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="パス">
        <MenuItem Header="オブジェクトをパスに変換" InputGesture="Ctrl+Shift+C" Command="{Binding ObjectToPathCommand}" />
        <MenuItem Header="ストロークをパスに変換" InputGesture="Ctrl+Alt+C" Command="{Binding StrokeToPathCommand}" />
        <Separator />
        <MenuItem Header="統合" InputGesture="Ctrl+Shift+U" Command="{Binding BooleanUnionActiveLayerShapesCommand}" />
        <MenuItem Header="差分" InputGesture="Ctrl+Shift+D" Command="{Binding BooleanDifferenceActiveLayerShapesCommand}" />
        <MenuItem Header="交差" InputGesture="Ctrl+Shift+I" Command="{Binding BooleanIntersectionCommand}" />
        <MenuItem Header="排他的論理和" InputGesture="Ctrl+Shift+X" Command="{Binding BooleanXorCommand}" />
        <MenuItem Header="逆差分" InputGesture="Ctrl+Shift+R" Command="{Binding BooleanReverseDifferenceCommand}" />
        <MenuItem Header="開く/閉じる" InputGesture="Ctrl+K" Command="{Binding TogglePathClosedCommand}" />
        <MenuItem Header="端点を結合" Command="{Binding JoinPathCommand}" />
        <MenuItem Header="シンプル化" InputGesture="Ctrl+L" Command="{Binding SimplifyPathCommand}" />
      </MenuItem>
      <MenuItem Header="レイヤー">
        <MenuItem Header="新規レイヤー" InputGesture="Ctrl+Shift+N" Command="{Binding NewLayerCommand}" />
        <MenuItem Header="レイヤーを複製" Command="{Binding DuplicateLayerCommand}" />
        <MenuItem Header="レイヤーを削除" Command="{Binding DeleteLayerCommand}" />
        <MenuItem Header="回転・反転">
          <MenuItem Header="時計回り90°" Command="{Binding RotateLayerCommand}" CommandParameter="90" />
          <MenuItem Header="反時計回り90°" Command="{Binding RotateLayerCommand}" CommandParameter="-90" />
          <MenuItem Header="180°" Command="{Binding RotateLayerCommand}" CommandParameter="180" />
          <MenuItem Header="左右反転" Command="{Binding RotateLayerCommand}" CommandParameter="flip-x" />
          <MenuItem Header="上下反転" Command="{Binding RotateLayerCommand}" CommandParameter="flip-y" />
          <Separator />
          <MenuItem Header="角度を指定して回転…" Command="{Binding OpenRotateLayerDialogCommand}" />
        </MenuItem>
        <MenuItem Header="合成モード">
          <MenuItem Header="Normal" Command="{Binding SetLayerBlendCommand}" CommandParameter="{x:Static styling:LayerBlendMode.Normal}" />
          <MenuItem Header="Multiply" Command="{Binding SetLayerBlendCommand}" CommandParameter="{x:Static styling:LayerBlendMode.Multiply}" />
          <MenuItem Header="Screen" Command="{Binding SetLayerBlendCommand}" CommandParameter="{x:Static styling:LayerBlendMode.Screen}" />
          <MenuItem Header="Overlay" Command="{Binding SetLayerBlendCommand}" CommandParameter="{x:Static styling:LayerBlendMode.Overlay}" />
          <MenuItem Header="Add" Command="{Binding SetLayerBlendCommand}" CommandParameter="{x:Static styling:LayerBlendMode.Add}" />
          <MenuItem Header="Subtract" Command="{Binding SetLayerBlendCommand}" CommandParameter="{x:Static styling:LayerBlendMode.Subtract}" />
          <MenuItem Header="Difference" Command="{Binding SetLayerBlendCommand}" CommandParameter="{x:Static styling:LayerBlendMode.Difference}" />
          <MenuItem Header="Darken" Command="{Binding SetLayerBlendCommand}" CommandParameter="{x:Static styling:LayerBlendMode.Darken}" />
          <MenuItem Header="Lighten" Command="{Binding SetLayerBlendCommand}" CommandParameter="{x:Static styling:LayerBlendMode.Lighten}" />
        </MenuItem>
        <MenuItem Header="順序">
          <MenuItem Header="最前面" Command="{Binding OrderLayerCommand}" CommandParameter="front" />
          <MenuItem Header="前面へ" Command="{Binding OrderLayerCommand}" CommandParameter="forward" />
          <MenuItem Header="背面へ" Command="{Binding OrderLayerCommand}" CommandParameter="backward" />
          <MenuItem Header="最背面" Command="{Binding OrderLayerCommand}" CommandParameter="back" />
        </MenuItem>
        <MenuItem Header="下のレイヤーと結合" InputGesture="Ctrl+E" Command="{Binding MergeLayerDownCommand}" />
        <MenuItem Header="表示切替" Command="{Binding ToggleLayerVisibilityCommand}" />
        <MenuItem Header="ロック切替" Command="{Binding ToggleLayerLockCommand}" />
      </MenuItem>
      <MenuItem Header="フィルタ・拡張">
        <MenuItem Header="ぼかしフィルタ (Gaussian Blur)…" Command="{Binding OpenBlurInspectorCommand}" />
        <MenuItem Header="レイヤーのぼかし切替" Command="{Binding ToggleGaussianBlurOnActiveLayerCommand}" />
        <MenuItem Header="フィルタをクリア" Command="{Binding ClearFiltersCommand}" />
        <Separator />
        <MenuItem Header="SkSL シェーダーを適用…" Command="{Binding OpenShaderInspectorCommand}" />
        <MenuItem Header="プラグインコマンド" ItemsSource="{Binding PluginMenus}">
          <MenuItem.ItemContainerTheme>
            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="plugins:IMenuContribution">
              <Setter Property="Header" Value="{Binding Title}" />
              <Setter Property="Command" Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExecutePluginMenuCommand}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
            </ControlTheme>
          </MenuItem.ItemContainerTheme>
        </MenuItem>
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,1" Padding="10,6">
      <Grid ColumnDefinitions="*,Auto">
        <DockPanel Margin="0,0,8,0">
          <TextBlock DockPanel.Dock="Left" Text="{Binding ActiveToolItem.Title}" FontWeight="SemiBold" MinWidth="60" />
          <Button DockPanel.Dock="Left" Content="⋯" ToolTip.Tip="ツールの詳細設定" Margin="0,0,8,0">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <ScrollViewer MaxHeight="460" Width="410">
                  <StackPanel Spacing="10">
                    <TextBlock Text="ツール設定" FontWeight="SemiBold" />
                    <StackPanel Spacing="8" IsVisible="{Binding IsRectangleTool}">
                      <TextBlock Text="角丸 Rx" /><NumericUpDown Value="{Binding CornerRadius}" Minimum="0" Maximum="1000" />
                      <TextBlock Text="角丸 Ry" /><NumericUpDown Value="{Binding CornerRadiusY}" Minimum="0" Maximum="1000" />
                      <CheckBox Content="Rx / Ry をリンク" IsChecked="{Binding LinkCorners}" /><Button Content="角丸リセット" Command="{Binding ResetCornersCommand}" />
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding IsPolygonTool}">
                      <TextBlock Text="頂点数 (3〜64)" /><NumericUpDown Value="{Binding PolygonSides}" Minimum="3" Maximum="64" Increment="1" FormatString="0" />
                      <StackPanel IsVisible="{Binding IsStarTool}"><TextBlock Text="内径比" /><NumericUpDown Value="{Binding InnerRatio}" Minimum="0.05" Maximum="0.95" Increment="0.05" /></StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding IsArcTool}">
                      <ComboBox ItemsSource="{Binding ArcModes}" SelectedItem="{Binding ArcMode}" />
                      <TextBlock Text="開始角°" /><NumericUpDown Value="{Binding ArcStart}" Minimum="-360" Maximum="360" />
                      <TextBlock Text="展開角°" /><NumericUpDown Value="{Binding ArcSweep}" Minimum="-360" Maximum="360" />
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding IsFreehandTool}">
                      <TextBlock Text="スムージング (%)" /><NumericUpDown Value="{Binding Smoothing}" Minimum="0" Maximum="100" />
                      <CheckBox Content="描画後にパスを閉じる" IsChecked="{Binding CloseFreehand}" />
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding IsBezierTool}">
                      <CheckBox Content="直線ポリライン" IsChecked="{Binding BezierPolyline}" />
                      <Button Content="開いたパスとして確定 (Enter)" Command="{Binding FinishBezierCommand}" />
                      <Button Content="閉じて確定" Command="{Binding CloseBezierCommand}" />
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding IsNodeTool}">
                      <WrapPanel Orientation="Horizontal">
                        <Button Content="中点追加" Command="{Binding AddNodeCommand}" /><Button Content="点を削除" Command="{Binding DeleteNodeCommand}" />
                        <Button Content="コーナー" Command="{Binding CornerNodeCommand}" /><Button Content="スムーズ" Command="{Binding SmoothNodeCommand}" /><Button Content="対称" Command="{Binding SymmetricNodeCommand}" />
                        <Button Content="直線化" Command="{Binding StraightSegmentCommand}" /><Button Content="曲線化" Command="{Binding CurvedSegmentCommand}" />
                        <Button Content="端点結合" Command="{Binding JoinPathCommand}" /><Button Content="選択点で切断" Command="{Binding CutPathCommand}" />
                        <Button Content="開く/閉じる" Command="{Binding TogglePathClosedCommand}" />
                      </WrapPanel>
                      <TextBlock Text="単純化の許容誤差 (px)" /><NumericUpDown Value="{Binding SimplifyTolerance}" Minimum="0.1" Maximum="50" Increment="0.5" />
                      <Button Content="シンプル化" Command="{Binding SimplifyPathCommand}" />
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding IsTextTool}">
                      <TextBlock Text="フォント" /><TextBox Text="{Binding FontFamily}" />
                      <TextBlock Text="サイズ (px)" /><NumericUpDown Value="{Binding FontSize}" Minimum="1" Maximum="1000" />
                      <StackPanel Orientation="Horizontal" Spacing="8"><ToggleButton Content="太字" IsChecked="{Binding TextBold}" /><ToggleButton Content="斜体" IsChecked="{Binding TextItalic}" /></StackPanel>
                      <ComboBox ItemsSource="{Binding TextAlignments}" SelectedItem="{Binding TextAlignment}" />
                      <TextBlock Text="字間 (px)" /><NumericUpDown Value="{Binding LetterSpacing}" Minimum="-100" Maximum="1000" />
                      <TextBlock Text="キャンバスをクリックして入力。Ctrl+Enterで確定、Escで取消。" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding HasShapeDetails}">
                      <TextBlock Text="図形のローカル座標・寸法" FontWeight="SemiBold" />
                      <TextBlock Text="X / Cx" /><NumericUpDown Value="{Binding GeometryX}" Minimum="-1000000" Maximum="1000000" />
                      <TextBlock Text="Y / Cy" /><NumericUpDown Value="{Binding GeometryY}" Minimum="-1000000" Maximum="1000000" />
                      <StackPanel Spacing="6" IsVisible="{Binding HasRectangle}"><TextBlock Text="幅" /><NumericUpDown Value="{Binding GeometryWidth}" Minimum="0.01" Maximum="1000000" /><TextBlock Text="高さ" /><NumericUpDown Value="{Binding GeometryHeight}" Minimum="0.01" Maximum="1000000" /></StackPanel>
                      <StackPanel Spacing="6" IsVisible="{Binding HasRadialShape}"><TextBlock Text="半径 Rx" /><NumericUpDown Value="{Binding RadiusX}" Minimum="0.01" Maximum="1000000" /><TextBlock Text="半径 Ry" /><NumericUpDown Value="{Binding RadiusY}" Minimum="0.01" Maximum="1000000" /><ComboBox ItemsSource="{Binding EllipseModes}" SelectedItem="{Binding EllipseMode}" /></StackPanel>
                      <ComboBox IsVisible="{Binding HasParametricPolygon}" ItemsSource="{Binding PolygonModes}" SelectedItem="{Binding PolygonMode}" />
                      <Button Content="図形に適用" Command="{Binding ApplyShapeDetailsCommand}" />
                    </StackPanel>
                    <StackPanel Spacing="6" IsVisible="{Binding HasSelection}"><TextBlock Text="傾斜 X° / Y°（変形適用時）" /><NumericUpDown Value="{Binding ShearX}" Minimum="-85" Maximum="85" /><NumericUpDown Value="{Binding ShearY}" Minimum="-85" Maximum="85" /><Button Content="変形を適用" Command="{Binding ApplyTransformCommand}" /></StackPanel>
                    <TextBlock Text="レイヤーの任意角度°（キャンバス中心）" /><NumericUpDown Value="{Binding LayerAngle}" Minimum="-360" Maximum="360" /><Button Content="レイヤーを回転" Command="{Binding RotateLayerCommand}" CommandParameter="custom" />
                    <TextBlock Text="線種" /><ComboBox ItemsSource="{Binding DashOptions}" SelectedItem="{Binding StrokeDash}" PlaceholderText="混在 / カスタム" />
                  </StackPanel>
                </ScrollViewer>
              </Flyout>
            </Button.Flyout>
          </Button>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="600">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowTransformInputs}"><TextBlock Text="X" /><NumericUpDown Value="{Binding SelectionX}" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><TextBlock Text="Y" /><NumericUpDown Value="{Binding SelectionY}" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><TextBlock Text="W" /><NumericUpDown Value="{Binding SelectionWidth}" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><TextBlock Text="H" /><NumericUpDown Value="{Binding SelectionHeight}" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><Button Content="適用" Command="{Binding ApplyTransformCommand}" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsNodeTool}"><TextBlock Text="Node X" /><NumericUpDown Value="{Binding NodeX}" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><TextBlock Text="Y" /><NumericUpDown Value="{Binding NodeY}" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><Button Content="適用" Command="{Binding ApplyNodeCoordinatesCommand}" IsEnabled="{Binding HasSelectedAnchors}" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowRadialInputs}"><TextBlock Text="Cx" /><NumericUpDown Value="{Binding GeometryX}" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><TextBlock Text="Cy" /><NumericUpDown Value="{Binding GeometryY}" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><TextBlock Text="Rx" /><NumericUpDown Value="{Binding RadiusX}" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><TextBlock Text="Ry" /><NumericUpDown Value="{Binding RadiusY}" Minimum="-1000000" Maximum="1000000" ShowButtonSpinner="False" MinWidth="72" Width="72" /><Button Content="適用" Command="{Binding ApplyShapeDetailsCommand}" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowPolygonInputs}"><TextBlock Text="角数" /><NumericUpDown Value="{Binding PolygonSides}" Minimum="3" Maximum="64" ShowButtonSpinner="False" MinWidth="72" Width="72" /><TextBlock Text="R" /><NumericUpDown Value="{Binding OuterRadius}" Minimum="0.01" Maximum="100000" ShowButtonSpinner="False" MinWidth="72" Width="72" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsTextTool}"><TextBox Text="{Binding FontFamily}" Width="110" /><NumericUpDown Value="{Binding FontSize}" Minimum="1" Maximum="1000" ShowButtonSpinner="False" MinWidth="72" Width="72" /></StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{Binding StyleTarget}" FontSize="11" />
          <Button Content="塗り" ToolTip.Tip="塗り色">
            <Button.Flyout><Flyout><StackPanel Spacing="8" Width="220">
              <TextBlock Text="塗り (#RRGGBB / #AARRGGBB)" />
              <TextBox Text="{Binding FillColor}" Watermark="混在" />
              <ItemsControl ItemsSource="{Binding ColorSwatches}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ColorSwatch"><Button Width="32" Height="32" Margin="2" Background="{Binding Brush}" ToolTip.Tip="{Binding Value}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetFillColorCommand}" CommandParameter="{Binding Value}" /></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="塗りなし" Command="{Binding ClearFillCommand}" />
            </StackPanel></Flyout></Button.Flyout>
          </Button>
          <TextBox Text="{Binding FillColor}" Width="90" Watermark="混在" />
          <Button Content="線" ToolTip.Tip="線色">
            <Button.Flyout><Flyout><StackPanel Spacing="8" Width="220">
              <TextBox Text="{Binding StrokeColor}" Watermark="混在" />
              <ItemsControl ItemsSource="{Binding ColorSwatches}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ColorSwatch"><Button Width="32" Height="32" Margin="2" Background="{Binding Brush}" ToolTip.Tip="{Binding Value}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetStrokeColorCommand}" CommandParameter="{Binding Value}" /></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="線なし" Command="{Binding ClearStrokeCommand}" />
            </StackPanel></Flyout></Button.Flyout>
          </Button>
          <TextBox Text="{Binding StrokeColor}" Width="90" Watermark="混在" />
          <NumericUpDown Value="{Binding StrokeWidth}" Minimum="0" Maximum="1000" Increment="0.5" ToolTip.Tip="線幅 (px) / 空欄は混在" />
        </StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="10,6">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto">
        <TextBlock Text="{Binding CursorPosition}" MinWidth="105" FontSize="12" />
        <TextBlock Grid.Column="1" Text="{Binding SelectionSummary}" Margin="12,0" FontSize="12" />
        <TextBlock Grid.Column="2" Text="{Binding ToolHint}" TextTrimming="CharacterEllipsis" Foreground="#94A3B8" FontSize="12" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
          <ToggleButton Content="グリッド" IsChecked="{Binding ShowGrid}" />
          <ToggleButton Content="スナップ" IsChecked="{Binding SnapToGrid}" ToolTip.Tip="グリッド・頂点・境界に吸着" />
          <Button Content="−" Command="{Binding ZoomOutCommand}" /><Button Content="{Binding ZoomLabel}" Command="{Binding ResetZoomCommand}" /><Button Content="+" Command="{Binding ZoomInCommand}" />
        </StackPanel>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
    <Border DockPanel.Dock="Left" Width="58" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <ListBox Classes="tools" ItemsSource="{Binding Tools}" SelectedItem="{Binding ActiveToolItem}" Background="Transparent" SelectionMode="Single">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ToolItem">
                <controls:ToolIcon Icon="{Binding Icon}" Width="24" Height="24" ToolTip.Tip="{Binding Hint}" AutomationProperties.Name="{Binding Title}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Separator Margin="6,8" />
          <ItemsControl ItemsSource="{Binding PluginToolbarItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="plugins:IToolbarContribution">
                <Button Content="+" Margin="7,3" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Title}" AutomationProperties.Name="{Binding Title}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExecutePluginToolbarItemCommand}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Border DockPanel.Dock="Right" Width="300" Background="#161B22" BorderBrush="#30363D" BorderThickness="1,0,0,0" Padding="6">
      <Grid RowDefinitions="3*,4,2*">
        <TabControl Grid.Row="0" Padding="4" SelectedIndex="{Binding SelectedInspectorTab}">
          <TabItem Header="塗り＆線" FontSize="13">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10" Margin="0,4,4,8">
                <TextBlock Text="{Binding StyleTarget, StringFormat='編集対象: {0}'}" FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold" />
                <Expander Header="塗りつぶし (Fill)" IsExpanded="True" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="72,*">
                      <TextBlock Text="塗り種別" />
                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding FillKinds}" SelectedItem="{Binding FillKind}" PlaceholderText="混在" />
                    </Grid>
                    <StackPanel Spacing="6" IsVisible="{Binding IsSolidFill}">
                      <Grid ColumnDefinitions="72,*">
                        <TextBlock Text="単色 HEX" />
                        <TextBox Grid.Column="1" Text="{Binding FillColor}" Watermark="混在 (#RRGGBB / #AARRGGBB)" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding ColorSwatches}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ColorSwatch">
                            <Button Width="24" Height="24" Margin="2" Background="{Binding Brush}" ToolTip.Tip="{Binding Value}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetFillColorCommand}" CommandParameter="{Binding Value}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="6" IsVisible="{Binding IsTextureFill}">
                      <Grid ColumnDefinitions="72,*">
                        <TextBlock Text="パターン" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding TexturePatterns}" SelectedItem="{Binding TexturePattern}" PlaceholderText="混在" />
                      </Grid>
                      <Grid ColumnDefinitions="72,*,Auto">
                        <TextBlock Text="メイン色" />
                        <TextBox Grid.Column="1" Text="{Binding TexturePrimaryColor}" Watermark="混在" Margin="0,0,4,0" />
                        <Button Grid.Column="2" Content="色">
                          <Button.Flyout>
                            <Flyout>
                              <ItemsControl ItemsSource="{Binding ColorSwatches}" Width="180">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ColorSwatch">
                                    <Button Width="26" Height="26" Margin="2" Background="{Binding Brush}" ToolTip.Tip="{Binding Value}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetTexturePrimaryColorCommand}" CommandParameter="{Binding Value}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                      </Grid>
                      <Grid ColumnDefinitions="72,*,Auto">
                        <TextBlock Text="サブ色" />
                        <TextBox Grid.Column="1" Text="{Binding TextureSecondaryColor}" Watermark="混在" Margin="0,0,4,0" />
                        <Button Grid.Column="2" Content="色">
                          <Button.Flyout>
                            <Flyout>
                              <ItemsControl ItemsSource="{Binding ColorSwatches}" Width="180">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ColorSwatch">
                                    <Button Width="26" Height="26" Margin="2" Background="{Binding Brush}" ToolTip.Tip="{Binding Value}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetTextureSecondaryColorCommand}" CommandParameter="{Binding Value}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                      </Grid>
                      <TextBlock Text="スケール (4〜128 px)" />
                      <Grid ColumnDefinitions="*,90">
                        <Slider Minimum="4" Maximum="128" Value="{Binding TextureScale}" Margin="0,0,6,0" />
                        <NumericUpDown Grid.Column="1" Minimum="4" Maximum="128" Increment="2" Value="{Binding TextureScale}" MinWidth="80" />
                      </Grid>
                      <Grid ColumnDefinitions="72,*">
                        <TextBlock Text="角度 (°)" />
                        <NumericUpDown Grid.Column="1" Minimum="-180" Maximum="180" Increment="15" Value="{Binding TextureAngle}" />
                      </Grid>
                    </StackPanel>
                    <TextBlock Text="塗り不透明度 (%)" />
                    <Grid ColumnDefinitions="*,90">
                      <Slider Minimum="0" Maximum="100" Value="{Binding FillOpacity}" Margin="0,0,6,0" />
                      <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="5" Value="{Binding FillOpacity}" MinWidth="80" />
                    </Grid>
                  </StackPanel>
                </Expander>

                <Expander Header="ストローク詳細 (Stroke)" IsExpanded="True" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="72,*,Auto">
                      <TextBlock Text="線色" />
                      <TextBox Grid.Column="1" Text="{Binding StrokeColor}" Watermark="混在 / none" Margin="0,0,4,0" />
                      <Button Grid.Column="2" Content="線なし" Command="{Binding ClearStrokeCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ColorSwatch">
                          <Button Width="24" Height="24" Margin="2" Background="{Binding Brush}" ToolTip.Tip="{Binding Value}"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetStrokeColorCommand}" CommandParameter="{Binding Value}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="72,*">
                      <TextBlock Text="線幅 (px)" />
                      <NumericUpDown Grid.Column="1" Minimum="0" Maximum="1000" Increment="0.5" Value="{Binding StrokeWidth}" />
                    </Grid>
                    <TextBlock Text="線不透明度 (%)" />
                    <Grid ColumnDefinitions="*,90">
                      <Slider Minimum="0" Maximum="100" Value="{Binding StrokeOpacity}" Margin="0,0,6,0" />
                      <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="5" Value="{Binding StrokeOpacity}" MinWidth="80" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*">
                      <TextBlock Text="線端 (Cap)" />
                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding StrokeCaps}" SelectedItem="{Binding StrokeCap}" PlaceholderText="混在" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*">
                      <TextBlock Text="角 (Join)" />
                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding StrokeJoins}" SelectedItem="{Binding StrokeJoin}" PlaceholderText="混在" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*">
                      <TextBlock Text="Miter制限" />
                      <NumericUpDown Grid.Column="1" Minimum="1" Maximum="100" Increment="0.5" Value="{Binding StrokeMiterLimit}" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*">
                      <TextBlock Text="破線種別" />
                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding DashOptions}" SelectedItem="{Binding StrokeDash}" PlaceholderText="混在" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*,Auto">
                      <TextBlock Text="破線配列" />
                      <TextBox Grid.Column="1" Text="{Binding CustomDashArray}" Watermark="例: 8, 4, 2, 4" Margin="0,0,4,0" />
                      <Button Grid.Column="2" Content="適用" Command="{Binding ApplyCustomDashCommand}" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*">
                      <TextBlock Text="破線位相" />
                      <NumericUpDown Grid.Column="1" Minimum="-1000" Maximum="1000" Increment="1" Value="{Binding StrokeDashPhase}" />
                    </Grid>
                  </StackPanel>
                </Expander>

                <Expander Header="変形" IsExpanded="False" IsVisible="{Binding HasSelection}" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="6">
                    <TextBlock Text="X" /><NumericUpDown Value="{Binding SelectionX}" Minimum="-1000000" Maximum="1000000" />
                    <TextBlock Text="Y" /><NumericUpDown Value="{Binding SelectionY}" Minimum="-1000000" Maximum="1000000" />
                    <TextBlock Text="幅" /><NumericUpDown Value="{Binding SelectionWidth}" Minimum="0.01" Maximum="1000000" />
                    <TextBlock Text="高さ" /><NumericUpDown Value="{Binding SelectionHeight}" Minimum="0.01" Maximum="1000000" />
                    <CheckBox Content="縦横比を固定" IsChecked="{Binding LockAspect}" />
                    <TextBlock Text="追加回転°" /><NumericUpDown Value="{Binding SelectionRotation}" Minimum="-360" Maximum="360" />
                    <Button Content="変形を適用" Command="{Binding ApplyTransformCommand}" />
                  </StackPanel>
                </Expander>

                <Expander Header="多角形パラメータ" IsVisible="{Binding HasParametricPolygon}" IsExpanded="True" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="6">
                    <TextBlock Text="角数" /><NumericUpDown Value="{Binding PolygonSides}" Minimum="3" Maximum="64" FormatString="0" />
                    <TextBlock Text="外径" /><NumericUpDown Value="{Binding OuterRadius}" Minimum="0.01" Maximum="100000" />
                    <StackPanel IsVisible="{Binding HasStarPolygon}"><TextBlock Text="内径比（星形）" /><NumericUpDown Value="{Binding InnerRatio}" Minimum="0.05" Maximum="0.95" Increment="0.05" /></StackPanel>
                    <TextBlock Text="開始角°" /><NumericUpDown Value="{Binding PolygonAngle}" Minimum="-360" Maximum="360" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="効果/SkSL" FontSize="13">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10" Margin="0,4,4,8">
                <TextBlock Text="{Binding EffectTargetLabel, StringFormat='編集対象: {0}'}" FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold" />

                <Expander Header="合成・不透明度" IsExpanded="True" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="8">
                    <TextBlock Text="不透明度 (%)" />
                    <Grid ColumnDefinitions="*,90">
                      <Slider Minimum="0" Maximum="100" Value="{Binding EffectOpacity}" Margin="0,0,6,0" />
                      <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="5" Value="{Binding EffectOpacity}" MinWidth="80" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*">
                      <TextBlock Text="合成モード" />
                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding BlendModes}" SelectedItem="{Binding EffectBlendMode}" PlaceholderText="混在" />
                    </Grid>
                  </StackPanel>
                </Expander>

                <Expander Header="ガウスぼかし (Gaussian Blur)" IsExpanded="True" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="8">
                    <CheckBox Content="ぼかしフィルタを有効化" IsChecked="{Binding IsBlurEnabled}" />
                    <TextBlock Text="水平ぼかし σX (0〜100)" />
                    <Grid ColumnDefinitions="*,90">
                      <Slider Minimum="0" Maximum="100" Value="{Binding BlurSigmaX}" Margin="0,0,6,0" />
                      <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="0.5" Value="{Binding BlurSigmaX}" MinWidth="80" />
                    </Grid>
                    <TextBlock Text="垂直ぼかし σY (0〜100)" />
                    <Grid ColumnDefinitions="*,90">
                      <Slider Minimum="0" Maximum="100" Value="{Binding BlurSigmaY}" Margin="0,0,6,0" />
                      <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="0.5" Value="{Binding BlurSigmaY}" MinWidth="80" />
                    </Grid>
                    <CheckBox Content="水平・垂直 (σX = σY) を連動" IsChecked="{Binding LinkBlurSigma}" />
                    <Button Content="フィルタをクリア" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                </Expander>

                <Expander Header="SkSL シェーダー (SKRuntimeEffect)" IsExpanded="True" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="72,*">
                      <TextBlock Text="シェーダー" />
                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding ShaderOptions}" SelectedItem="{Binding SelectedShaderOption}" PlaceholderText="混在" />
                    </Grid>

                    <StackPanel Spacing="6" IsVisible="{Binding HasActiveShader}">
                      <TextBlock Text="Uniform パラメータ" FontWeight="SemiBold" FontSize="12" Foreground="#94A3B8" />
                      <ItemsControl ItemsSource="{Binding ShaderUniforms}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ShaderUniformItem">
                            <StackPanel Spacing="3" Margin="0,2">
                              <TextBlock Text="{Binding Name}" FontSize="12" />
                              <Grid ColumnDefinitions="*,90">
                                <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" Margin="0,0,6,0" />
                                <NumericUpDown Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Increment="{Binding Increment}" Value="{Binding Value}" MinWidth="80" />
                              </Grid>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Expander Header="ライブ SkSL エディタ" IsExpanded="False" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="6">
                          <TextBox Text="{Binding SkslSourceCode}" AcceptsReturn="True" TextWrapping="NoWrap" Height="150" FontFamily="Consolas, Monospace" FontSize="12" />
                          <Button Content="SkSL をコンパイル＆適用" Command="{Binding CompileAndApplySkslCommand}" HorizontalAlignment="Stretch" />
                          <Border IsVisible="{Binding HasSkslError}" Background="#3B1219" BorderBrush="#F87171" BorderThickness="1" Padding="6" CornerRadius="4">
                            <TextBlock Text="{Binding SkslCompileError}" Foreground="#FCA5A5" TextWrapping="Wrap" FontSize="11" />
                          </Border>
                        </StackPanel>
                      </Expander>
                    </StackPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#30363D" />

        <DockPanel Grid.Row="2" Margin="4,6,4,0">
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="レイヤー＆オブジェクト" FontWeight="SemiBold" FontSize="13" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                <Button Content="＋" Padding="6,2" ToolTip.Tip="新規レイヤー (Ctrl+Shift+N)" Command="{Binding NewLayerCommand}" />
                <Button Content="複製" Padding="6,2" ToolTip.Tip="レイヤーを複製" Command="{Binding DuplicateLayerCommand}" />
                <Button Content="回転" Padding="6,2" ToolTip.Tip="レイヤー回転・反転">
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem Header="時計回りに 90° 回転" Command="{Binding RotateLayerCommand}" CommandParameter="90" />
                      <MenuItem Header="反時計回りに 90° 回転" Command="{Binding RotateLayerCommand}" CommandParameter="-90" />
                      <MenuItem Header="180° 回転" Command="{Binding RotateLayerCommand}" CommandParameter="180" />
                      <MenuItem Header="左右反転" Command="{Binding RotateLayerCommand}" CommandParameter="flip-x" />
                      <MenuItem Header="上下反転" Command="{Binding RotateLayerCommand}" CommandParameter="flip-y" />
                      <Separator />
                      <MenuItem Header="角度を指定して回転…" Command="{Binding OpenRotateLayerDialogCommand}" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
                <Button Content="結合" Padding="6,2" ToolTip.Tip="下のレイヤーと結合 (Ctrl+E)" Command="{Binding MergeLayerDownCommand}" />
                <Button Content="🗑" Padding="6,2" ToolTip.Tip="選択要素またはレイヤーを削除" Command="{Binding DeleteTreeTargetCommand}" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="Auto,105,Auto,*" Margin="0,2,0,0">
              <TextBlock Text="合成:" FontSize="11" Foreground="#94A3B8" Margin="0,0,4,0" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding BlendModes}" SelectedItem="{Binding EffectBlendMode}" PlaceholderText="混在" FontSize="11" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Column="2" Text="不透明:" FontSize="11" Foreground="#94A3B8" Margin="8,0,4,0" />
              <Slider Grid.Column="3" Minimum="0" Maximum="100" Value="{Binding EffectOpacity}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>

          <TreeView x:Name="SceneHierarchyTree"
                    ItemsSource="{Binding SceneTree}"
                    SelectedItem="{Binding SelectedTreeItem, Mode=TwoWay}"
                    Background="Transparent"
                    DragDrop.AllowDrop="True">
            <TreeView.ItemContainerTheme>
              <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}" x:DataType="vm:SceneTreeItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              </ControlTheme>
            </TreeView.ItemContainerTheme>
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="vm:SceneTreeItem" ItemsSource="{Binding Children}">
                <Border Background="Transparent" Padding="2,1" DragDrop.AllowDrop="True">
                  <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                    <Button Grid.Column="0" Content="{Binding VisibilityIcon}" Padding="4,1" Background="Transparent" FontSize="11"
                            ToolTip.Tip="表示/非表示を切替"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleNodeVisibilityCommand}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Column="1" Content="{Binding LockIcon}" Padding="4,1" Background="Transparent" FontSize="11"
                            ToolTip.Tip="ロックを切替"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleNodeLockCommand}"
                            CommandParameter="{Binding}" />
                    <TextBlock Grid.Column="2" Text="{Binding KindIcon}" Margin="4,0" FontSize="12" />
                    <Panel Grid.Column="3">
                      <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsEditingName}" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="ダブルクリックで名前変更 · ドラッグで並び替え/階層移動" />
                      <TextBox Text="{Binding EditingNameText, Mode=TwoWay}" IsVisible="{Binding IsEditingName}" Padding="3,1" MinHeight="22" FontSize="12" />
                    </Panel>
                    <TextBlock Grid.Column="4" Text="{Binding EffectBadge}" IsVisible="{Binding HasEffectBadge}" Foreground="#F59E0B" FontSize="11" Margin="4,0,0,0" />
                    <TextBlock Grid.Column="5" Text="{Binding BlendBadge}" IsVisible="{Binding HasBlendBadge}" Foreground="#38BDF8" FontSize="11" Margin="4,0,0,0" />
                  </Grid>
                </Border>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Grid>
    </Border>
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="#161B22" Padding="8,3" IsVisible="{Binding IsInGroup}">
        <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="← 親へ" Command="{Binding ExitGroupCommand}" /><TextBlock Text="{Binding ScopePath}" /></StackPanel>
      </Border>
    <controls:VectorCanvasControl Workspace="{Binding}" RenderVersion="{Binding RenderVersion}" />
    </DockPanel>
  </DockPanel>
</Window>
